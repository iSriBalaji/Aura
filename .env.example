# LLM Provider Configuration (Choose Gemini, OpenAI, or run in rule-based fallback mode)
# Gemini is recommended for high speed and lowest cost:
GEMINI_API_KEY=
# Or OpenAI:
OPENAI_API_KEY=

# LLM Model Name (optional, defaults to gemini-2.5-flash or gpt-4o-mini if provider key is set)
LLM_MODEL=gemini-2.5-flash

# Default temperature unit: celsius or fahrenheit (default: celsius)
DEFAULT_TEMP_UNIT=celsius
